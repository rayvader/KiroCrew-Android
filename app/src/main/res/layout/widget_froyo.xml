<?xml version="1.0" encoding="utf-8"?>
<!-- "Froyo · Upcoming". 16 row slots (core/Upcoming.MAX_ROWS) and a "+N more" line. Heights here are the ones core/Upcoming.fit counts with:
     6 dp padding top and bottom, a 14sp header plus 2 dp, rows of 13sp text or a 12sp chip
     with 2 dp padding, plus 3 dp above and below. Change both together. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/froyo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/froyo_header"
