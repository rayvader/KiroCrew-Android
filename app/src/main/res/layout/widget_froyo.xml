<?xml version="1.0" encoding="utf-8"?>
<!-- "Froyo · Upcoming": a fixed header, then one scrolling list of day headers
     (widget_froyo_day.xml) and item cards (widget_froyo_item.xml), in the Google Calendar style. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/froyo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/froyo_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="22sp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/froyo_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/froyo_widget_title"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/froyo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <!-- Refresh now. A spinner takes its place while the read runs. -->
        <TextView
            android:id="@+id/froyo_refresh"
            android:layout_width="22sp"
            android:layout_height="22sp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/froyo_refresh"
            android:gravity="center"
            android:text="⟳"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/froyo_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="@string/froyo_updating"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/froyo_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/froyo_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone" />
</LinearLayout>
