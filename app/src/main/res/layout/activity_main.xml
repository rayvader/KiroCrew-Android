<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The top bar's colour is on this frame, so the art can sit behind the transparent
             toolbar. The Kiro ghost on a white circle sits over the start of the top bar; the bar's
             start inset keeps its title clear of it. The dot shows whether the gateway can
             be reached, in the same colours as on the Servers icon. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary">

            <!-- Faint ghosts and stars at the end of the bar, behind the action icons. Cut out
                 of their own background, so they sit on any accent colour. -->
            <ImageView
                android:id="@+id/top_bar_art"
                android:layout_width="wrap_content"
                android:layout_height="?attr/actionBarSize"
                android:layout_gravity="end"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd"
                android:src="@drawable/top_bar_art" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:contentInsetStart="64dp"
                app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
                app:subtitleTextColor="?attr/colorOnPrimary"
                app:titleTextColor="?attr/colorOnPrimary" />

            <FrameLayout
                android:id="@+id/top_ghost"
                android:layout_width="40dp"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginStart="12dp"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ghost_button_bg">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ghost_button" />
                </FrameLayout>

                <View
                    android:id="@+id/top_ghost_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="1dp"
                    android:layout_marginTop="9dp"
                    android:elevation="2dp"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone"
            app:trackThickness="2dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/webview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <ScrollView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/colorBackground"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ghost" />

                    <TextView
                        android:id="@+id/message_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:id="@+id/message_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/message_primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/message_secondary"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <!-- On the welcome and "Cannot reach the dashboard" screens. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/message_help"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/connect_help" />
                </LinearLayout>
            </ScrollView>

            <TextView
                android:id="@+id/insecure_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="?attr/colorErrorContainer"
                android:padding="8dp"
                android:text="@string/insecure_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnErrorContainer"
                android:visibility="gone" />

            <!-- When the top bar is off: the white Kiro ghost, outlined in purple, on a round white button,
                 half hidden past the right edge as if peeking in. Tapping it slides
                 it fully in and opens the menu; closing the menu slides it back.
                 The button is the touch area, so the visible half is tappable. -->
            <FrameLayout
                android:id="@+id/menu_fab"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/menu"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/menu_tab"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ghost_button_bg"
                    android:duplicateParentState="true"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/menu_tab_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ghost_button" />
                </FrameLayout>

                <!-- Gateway status: green connected, red not connected, grey checking. -->
                <View
                    android:id="@+id/menu_tab_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    android:elevation="5dp"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelVisibilityMode="labeled" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/lock_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/locked"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/unlock_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/unlock" />
    </LinearLayout>
</FrameLayout>
